generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Course {
  id        String   @id @default(cuid())
  url       String   @unique
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lessons   Lesson[]
}

model Lesson {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  order        Int
  transcript   String?
  summary      String?
  explanation  String?
  roadmap      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
