# Database — Prisma uses SQLite by default (file relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# OpenAI — fallback API key (optional, users configure via Settings UI)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Authentication — JWT signing secret (HS256). Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# Password hashing cost factor (default: 12)
BCRYPT_ROUNDS=12
